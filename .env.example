# Create locally with: install -m 600 .env.example .env
# Never commit .env or a rendered nginx.conf.

# OBS Stream Key is the nginx-rtmp publish name ($name), not a platform key.
# Ingest: rtmp://<VPS_IP>:1935/live/<publish_name>
# The nginx application is hard-coded to `live` in rtmp/nginx.conf.template.

# YouTube Studio → Go live → Stream → Stream key
YOUTUBE_STREAM_KEY=

# Twitch Creator Dashboard → Settings → Stream → Primary Stream key
TWITCH_STREAM_KEY=

# Kick Creator dashboard → Stream → Stream key
KICK_STREAM_KEY=

# Published ports (compose). Production on the VPS often uses --network=host instead.
RTMP_PORT=1935
STAT_PORT=8080
